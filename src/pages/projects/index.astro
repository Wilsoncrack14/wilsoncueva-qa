---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import ProjectsCatalog from '../../components/projects/ProjectsCatalog';
---

<BaseLayout
  title="Casos de estudio | Proyectos QA Automation — Wilson Cueva"
  description="Proyectos reales de testing y automatización donde aplico metodologías, herramientas y buenas prácticas de QA."
>
  <section class="bg-bg-primary py-10 sm:py-14">
    <Container class="space-y-8">
      <!-- Top Header + 3 KPI Summary Cards -->
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div class="space-y-1.5 max-w-xl">
          <p class="font-mono text-xs font-medium uppercase tracking-wider text-accent-lime">
            Proyectos
          </p>
          <h1 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
            Casos de <span class="text-accent-lime">estudio</span>
          </h1>
          <p class="text-sm leading-relaxed text-text-secondary">
            Proyectos reales de testing y automatización donde aplico metodologías, herramientas y buenas prácticas de QA.
          </p>
        </div>

        <!-- 3 KPI Cards (3 Proyectos, +120 Tests (total), 93.3% Pass rate) -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div class="flex items-center gap-3.5 rounded-2xl border border-white/[0.07] bg-bg-secondary px-5 py-3.5 min-w-[155px]">
            <svg class="h-5 w-5 text-accent-lime shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2" />
              <polyline points="2 17 12 22 22 17" />
              <polyline points="2 12 12 17 22 12" />
            </svg>
            <div>
              <p class="text-xl font-bold text-text-primary leading-none">3</p>
              <p class="mt-1 text-xs text-text-secondary">Proyectos</p>
            </div>
          </div>

          <div class="flex items-center gap-3.5 rounded-2xl border border-white/[0.07] bg-bg-secondary px-5 py-3.5 min-w-[165px]">
            <svg class="h-5 w-5 text-accent-lime shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="m9 12 2 2 4-4" />
            </svg>
            <div>
              <p class="text-xl font-bold text-text-primary leading-none">+120</p>
              <p class="mt-1 text-xs text-text-secondary">Tests (total)</p>
            </div>
          </div>

          <div class="flex items-center gap-3.5 rounded-2xl border border-white/[0.07] bg-bg-secondary px-5 py-3.5 min-w-[165px]">
            <svg class="h-5 w-5 text-accent-lime shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18" />
              <path d="m19 9-5 5-4-4-3 3" />
            </svg>
            <div>
              <p class="text-xl font-bold text-text-primary leading-none">93.3%</p>
              <p class="mt-1 text-xs text-text-secondary">Pass rate</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Sidebar + 3 Stacked Case Study Cards -->
      <ProjectsCatalog client:load />
    </Container>
  </section>
</BaseLayout>
