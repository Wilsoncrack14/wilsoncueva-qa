---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { project: entry.data },
  }));
}

const { project } = Astro.props;
const { metrics } = project;
---

<BaseLayout title={`${project.title} | Caso de Estudio QA`}>
  <div class="mx-auto max-w-5xl px-6 py-14 space-y-16">
    <!-- 1. CABECERA Y FICHA TÉCNICA -->
    <header class="space-y-4 border-b border-slate-800 pb-10">
      <a href="/" class="font-mono text-xs text-emerald-400 hover:underline">← Volver a proyectos</a>
      <div class="flex flex-wrap gap-2 pt-2">
        {project.techStack.map((tech) => (
          <span class="rounded-md border border-slate-800 bg-slate-900 px-2.5 py-1 font-mono text-xs text-slate-300">
            {tech}
          </span>
        ))}
      </div>
      <h1 class="text-3xl font-bold sm:text-5xl">{project.title}</h1>
      <p class="text-lg text-slate-400">{project.subtitle}</p>
      <p class="text-sm leading-relaxed text-slate-300">{project.executiveSummary}</p>

      <div class="flex flex-wrap gap-4 pt-3 text-xs font-mono text-slate-400">
        <span>Rol: <strong class="text-slate-200">{project.role}</strong></span>
        <span>Rama QA: <strong class="text-emerald-400">{project.links.qaBranch}</strong></span>
        <span>Commit Base: <strong class="text-emerald-400">{project.links.baseCommit}</strong></span>
        <a href={project.links.production} target="_blank" rel="noreferrer" class="text-sky-400 hover:underline">
          Producción ↗
        </a>
        <a href={project.links.repository} target="_blank" rel="noreferrer" class="text-sky-400 hover:underline">
          GitHub ↗
        </a>
      </div>
    </header>

    <!-- 2. MÉTRICAS Y DESGLOSE DE COBERTURA -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold">1. Métricas de Cobertura y Ejecución</h2>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
          <p class="font-mono text-3xl font-bold text-emerald-400">{metrics.totalTestCases}</p>
          <p class="mt-1 text-xs text-slate-400">Casos diseñados ({metrics.businessRisksMapped} riesgos)</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
          <p class="font-mono text-3xl font-bold text-sky-400">{metrics.vitestTotalTests}</p>
          <p class="mt-1 text-xs text-slate-400">Tests en {metrics.vitestSuites} suites Vitest ({metrics.vitestDurationSeconds}s)</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
          <p class="font-mono text-3xl font-bold text-amber-400">{metrics.playwrightTotalTests}</p>
          <p class="mt-1 text-xs text-slate-400">Flujos E2E en {metrics.playwrightSuites} suites Playwright</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
          <p class="font-mono text-3xl font-bold text-emerald-300">
            {metrics.executionResults.approved}/{metrics.totalTestCases}
          </p>
          <p class="mt-1 text-xs text-slate-400">
            Aprobados ({metrics.executionResults.partial} Parciales · {metrics.executionResults.blocked} Bloqueados)
          </p>
        </div>
      </div>

      <!-- Barra de distribución Automatizado vs Híbrido vs Manual -->
      <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-6 space-y-3">
        <p class="text-sm font-semibold">Distribución de Estrategia de Pruebas</p>
        <div class="grid gap-3 sm:grid-cols-3 text-xs">
          <div class="rounded-lg border border-emerald-500/20 bg-emerald-500/10 p-3">
            <span class="font-mono text-lg font-bold text-emerald-400">
              {metrics.coverageBreakdown.automated.count} ({metrics.coverageBreakdown.automated.percentage}%)
            </span>
            <p class="mt-1 text-slate-300">{metrics.coverageBreakdown.automated.label}</p>
          </div>
          <div class="rounded-lg border border-amber-500/20 bg-amber-500/10 p-3">
            <span class="font-mono text-lg font-bold text-amber-400">
              {metrics.coverageBreakdown.hybridPartial.count} ({metrics.coverageBreakdown.hybridPartial.percentage}%)
            </span>
            <p class="mt-1 text-slate-300">{metrics.coverageBreakdown.hybridPartial.label}</p>
          </div>
          <div class="rounded-lg border border-sky-500/20 bg-sky-500/10 p-3">
            <span class="font-mono text-lg font-bold text-sky-400">
              {metrics.coverageBreakdown.manual.count} ({metrics.coverageBreakdown.manual.percentage}%)
            </span>
            <p class="mt-1 text-slate-300">{metrics.coverageBreakdown.manual.label}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. PUNTOS CLAVE DE ARQUITECTURA AUDITADOS -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold">2. Arquitectura Bajo Prueba (SUT)</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {project.architectureHighlights.map((arch) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5">
            <h3 class="font-bold text-emerald-300">{arch.title}</h3>
            <p class="mt-2 text-sm text-slate-400 leading-relaxed">{arch.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. PIRÁMIDE DE PRUEBAS -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold">3. Pirámide de Automatización y Testing Manual</h2>
      <div class="space-y-4">
        {project.testingPyramid.map((layer) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-lg font-bold text-emerald-400">{layer.layer}</h3>
              {layer.tests && (
                <span class="rounded bg-slate-800 px-2.5 py-1 font-mono text-xs text-slate-300">
                  {layer.files} archivos · {layer.tests} tests · {layer.duration}
                </span>
              )}
              {layer.cases && (
                <span class="rounded bg-slate-800 px-2.5 py-1 font-mono text-xs text-slate-300">
                  {layer.cases} casos híbridos/manuales
                </span>
              )}
            </div>
            <ul class="mt-4 list-disc space-y-1.5 pl-5 text-sm text-slate-300">
              {layer.scope.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. HALLAZGOS REALES Y SOLUCIONES -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold">4. Defectos y Hallazgos Reales Detectados</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {project.keyFindingsAndSolutions.map((item) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs font-mono">
                <span class="font-bold text-amber-400">{item.id}</span>
                <span class="rounded bg-slate-800 px-2 py-0.5 text-slate-300">{item.type} · {item.severity}</span>
              </div>
              <h3 class="mt-3 font-bold text-base">{item.title}</h3>
              <p class="mt-2 text-sm text-slate-400 leading-relaxed">{item.detail}</p>
              {item.solution && (
                <p class="mt-3 rounded-lg border border-emerald-500/20 bg-emerald-500/10 p-2.5 text-xs text-emerald-300">
                  <strong>Remediación:</strong> {item.solution}
                </p>
              )}
            </div>
            <div class="mt-4 flex flex-wrap gap-1.5 pt-3 border-t border-slate-800/80">
              {item.caseIds.map((cid) => (
                <span class="rounded bg-slate-950 px-2 py-0.5 font-mono text-[11px] text-slate-400">
                  {cid}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. TABLA DE COBERTURA POR MÓDULO -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold">5. Desglose por Módulo (78 Casos)</h2>
      <div class="overflow-x-auto rounded-xl border border-slate-800">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-800 bg-slate-900/90 font-mono text-xs uppercase text-slate-400">
            <tr>
              <th class="px-4 py-3">Módulo</th>
              <th class="px-4 py-3 text-center">Casos</th>
              <th class="px-4 py-3 text-center">Aprobados</th>
              <th class="px-4 py-3 text-center">Parciales (Manual/UI)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {project.modulesSummary.map((m) => (
              <tr class="hover:bg-slate-900/40">
                <td class="px-4 py-3 font-medium">{m.module}</td>
                <td class="px-4 py-3 text-center font-mono">{m.cases}</td>
                <td class="px-4 py-3 text-center font-mono text-emerald-400">{m.approved}</td>
                <td class="px-4 py-3 text-center font-mono text-amber-400">{m.partial}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
