---
import Container from '../layout/Container.astro';
import TerminalDemo from './TerminalDemo';
import { profileData } from '../../data/profile';
---

<section class="relative overflow-hidden border-b border-white/[0.05] bg-bg-primary py-12 sm:py-16 lg:py-20">
  <!-- Subtle, low-saturation radial light instead of heavy neon wave -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute right-[10%] top-[10%] h-64 w-96 rounded-full bg-accent-lime/[0.04] blur-[120px]"></div>
  </div>

  <Container class="relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Left Column -->
      <div class="space-y-6 lg:col-span-6 min-w-0">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-3.5 py-1 text-xs font-medium text-text-secondary">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-lime" aria-hidden="true"></span>
          <span>QA Automation Engineer</span>
        </div>

        <div class="space-y-2">
          <h1 class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
            {profileData.name}
          </h1>
          <p class="text-lg font-medium text-accent-lime/90 sm:text-xl">
            {profileData.role}
          </p>
        </div>

        <p class="max-w-xl text-sm leading-relaxed text-text-secondary sm:text-base">
          {profileData.heroDescription}
        </p>

        <!-- Refined CTA Row without oversaturated glow -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="/projects"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent-lime px-5 py-2.5 text-xs font-semibold text-bg-primary transition hover:bg-accent-lime-dim focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-lime sm:text-sm"
          >
            <span>Ver proyectos</span>
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={profileData.cvUrl}
            download="Wilson_Cueva_CV_QA_Automation.pdf"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/[0.09] bg-surface px-5 py-2.5 text-xs font-medium text-text-primary transition hover:border-white/[0.2] hover:bg-white/[0.04] focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-lime sm:text-sm"
          >
            <span class="text-accent-lime" aria-hidden="true">↓</span>
            <span>Descargar CV</span>
          </a>
        </div>

        <!-- Bottom Location & Specialization Metadata Row -->
        <div class="flex flex-wrap items-center gap-3 pt-2 text-xs text-text-secondary">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>{profileData.location}</span>
          </span>

          <span class="text-white/[0.12]" aria-hidden="true">·</span>

          <span class="inline-flex items-center gap-1.5">
            <span>QA Automation</span>
          </span>

          <span class="text-white/[0.12]" aria-hidden="true">·</span>

          <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-text-secondary">
            <span>Web · API · Performance</span>
          </span>
        </div>
      </div>

      <!-- Right Column: Terminal -->
      <div class="lg:col-span-6 min-w-0">
        <TerminalDemo client:load />
      </div>
    </div>
  </Container>
</section>
